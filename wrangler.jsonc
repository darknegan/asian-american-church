{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "asian-american-church",
  "compatibility_date": "2026-05-09",
  "observability": {
    "enabled": true
  },
  "assets": {
    // Angular `application` builder emits browser bundles here (not `dist/` root).
    "directory": "dist/asian-american-church/browser",
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
